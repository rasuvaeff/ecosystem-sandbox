# dev | test | prod (App\Environment refuses anything else); APP_DEBUG=true
# answers errors with stack-trace pages.
APP_ENV=dev
APP_DEBUG=false
# The address the pages' canonical and Open Graph URLs are built on, and
# whether robots.txt lets crawlers in (only for a deliberate deployment).
#APP_PUBLIC_URL=http://127.0.0.1:8080
#APP_INDEXABLE=false

# Copy to .env and adjust; compose reads it automatically.

# Published ports
APP_PORT=8080
PAYMENT_MOCK_PORT=8081
WEBHOOK_MOCK_PORT=8082
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
CENTRIFUGO_PORT=8000
CLICKHOUSE_PORT=18123
GRAFANA_PORT=13000

# Business switches
# First value of the payments.enabled flag, seeded by the flag data migration (migrate:up); then /admin/flags decides.
PAYMENTS_ENABLED=true
# Opt-in reCAPTCHA gate on the checkout (needs the internet; Google's test keys are built in).
CAPTCHA_ENABLED=false
#RECAPTCHA_SITE_KEY=
#RECAPTCHA_SECRET=
#RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
MAINTENANCE_ENABLED=false
MAINTENANCE_RETRY_AFTER=120
MAINTENANCE_BYPASS_TOKEN=sandbox-maintenance-bypass

# Payment gateway (typed through yii3-settings)
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_GATEWAY_TIMEOUT_MS=3000
PAYMENT_GATEWAY_CONNECT_TIMEOUT_MS=1000

# Payment mock behaviour
PAYMENT_MOCK_DELAY_MS=0
PAYMENT_MOCK_FAIL=0
PAYMENT_MOCK_UNAVAILABLE=0

# Webhook mock behaviour
WEBHOOK_FAIL_FIRST=0

# MCP endpoint
MCP_ENDPOINT_SECRET=sandbox-mcp-secret
MCP_USER_ID=demo-user

# Realtime profile
CENTRIFUGO_API_URL=http://centrifugo:9000
# A/B test: worker export to ClickHouse (`make ui-full` sets 1) and the three
# signing secrets (demo values are built in).
AB_EXPORT=0
#AB_AGGREGATE_SECRET=
#AB_COOKIE_SECRET=
#AB_RECEIPT_SECRET=
CENTRIFUGO_API_KEY=sandbox-centrifugo-key
# Signs the browser's connection token; at least 32 bytes
CENTRIFUGO_TOKEN_SECRET=sandbox-centrifugo-token-secret-0123456789

# Web UI worker — set by the make ui* targets on their command line, which
# wins over this file. Uncomment only for a hand-run `docker compose --profile ui up`.
# OUTBOX_RETRY_DELAY_SECONDS=10   # pause between outbox attempts; 10 outlasts the breaker cooldown
# RESULT_SINKS=centrifugo,webhooks,receipts  # subscribers of the result fan-out: centrifugo, webhooks, receipts, clickhouse
#FILES_SIGNING_KEY=  # signs receipt download URLs (32+ bytes; demo value built in)

# Property testing (optional regression corpus)
# PROPERTY_DB=/workspace/sandbox/build/property-db
# PROPERTY_SEED=20261013
