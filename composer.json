{
    "name": "rasuvaeff/ecosystem-sandbox",
    "description": "Runnable checkout sandbox for the rasuvaeff PHP package ecosystem",
    "license": "BSD-3-Clause",
    "type": "project",
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        },
        {
            "name": "Claude",
            "homepage": "https://www.anthropic.com/claude",
            "role": "Co-author"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "ext-json": "*",
        "ext-pdo_pgsql": "*",
        "guzzlehttp/guzzle": "^7.8",
        "httpsoft/http-message": "^1.1",
        "predis/predis": "^2.3",
        "psr/clock": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "rasuvaeff/clickhouse-toolkit": "^1.12",
        "rasuvaeff/context": "^0.3",
        "rasuvaeff/context-http": "^0.3",
        "rasuvaeff/openapi-contract": "^0.16",
        "rasuvaeff/payments": "^0.2",
        "rasuvaeff/property-testing-core": "^1.2",
        "rasuvaeff/property-testing-openapi": "^0.19",
        "rasuvaeff/resilience": "^0.3",
        "rasuvaeff/result": "^1.0",
        "rasuvaeff/schema": "^0.4",
        "rasuvaeff/specification": "^1.3",
        "rasuvaeff/yii3-ab-testing": "^2.1",
        "rasuvaeff/yii3-ab-testing-clickhouse": "^2.0",
        "rasuvaeff/yii3-ab-testing-outbox": "^3.0",
        "rasuvaeff/yii3-ab-testing-web": "^2.1",
        "rasuvaeff/yii3-api-problem": "^1.0",
        "rasuvaeff/yii3-audit-log": "^1.2",
        "rasuvaeff/yii3-audit-log-db": "^2.0",
        "rasuvaeff/yii3-centrifugo": "^1.1",
        "rasuvaeff/yii3-clickhouse-toolkit": "^1.4",
        "rasuvaeff/yii3-correlation-id": "^2.0",
        "rasuvaeff/yii3-feature-flags": "^1.1",
        "rasuvaeff/yii3-feature-flags-db": "^2.1",
        "rasuvaeff/yii3-feature-flags-ui": "^2.0",
        "rasuvaeff/yii3-filestorage": "^0.1",
        "rasuvaeff/yii3-filestorage-attachments": "^0.1",
        "rasuvaeff/yii3-filestorage-db": "^0.1",
        "rasuvaeff/yii3-filestorage-web": "^0.2",
        "rasuvaeff/yii3-health-check": "^1.1",
        "rasuvaeff/yii3-idempotency": "^2.1",
        "rasuvaeff/yii3-idempotency-db": "^3.0",
        "rasuvaeff/yii3-maintenance-mode": "^1.1",
        "rasuvaeff/yii3-mcp": "^4.1",
        "rasuvaeff/yii3-mcp-audit-log-bridge": "^2.2",
        "rasuvaeff/yii3-mcp-rbac-bridge": "^1.3",
        "rasuvaeff/yii3-mcp-telemetry-bridge": "^1.4",
        "rasuvaeff/yii3-metrics": "^2.4",
        "rasuvaeff/yii3-metrics-prometheus": "^2.3",
        "rasuvaeff/yii3-outbox": "^1.8",
        "rasuvaeff/yii3-outbox-clickhouse": "^1.6",
        "rasuvaeff/yii3-outbox-db": "^2.6",
        "rasuvaeff/yii3-outbox-webhooks-bridge": "^1.2",
        "rasuvaeff/yii3-recaptcha": "^2.0",
        "rasuvaeff/yii3-seo": "^1.2",
        "rasuvaeff/yii3-settings": "^1.2",
        "rasuvaeff/yii3-settings-db": "^2.0",
        "rasuvaeff/yii3-settings-ui": "^2.0",
        "rasuvaeff/yii3-telemetry": "^1.2",
        "rasuvaeff/yii3-telemetry-otel": "^1.2",
        "rasuvaeff/yii3-tenancy": "^1.1",
        "rasuvaeff/yii3-utm": "^1.1",
        "rasuvaeff/yii3-utm-db": "^1.2",
        "rasuvaeff/yii3-webhooks": "^2.0",
        "rasuvaeff/yii3-webhooks-db": "^3.0",
        "rasuvaeff/yii3-workflow": "^1.1",
        "rasuvaeff/yii3-workflow-db": "^2.0",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0",
        "vlucas/phpdotenv": "^5.7",
        "yiisoft/cache-file": "^3.2",
        "yiisoft/config": "^1.6",
        "yiisoft/csrf": "^2.2",
        "yiisoft/data-response": "^2.2",
        "yiisoft/db": "^2.0",
        "yiisoft/db-migration": "^2.1",
        "yiisoft/db-pgsql": "^2.0",
        "yiisoft/definitions": "^3.4",
        "yiisoft/di": "^1.4",
        "yiisoft/error-handler": "^4.3",
        "yiisoft/injector": "^1.2",
        "yiisoft/input-http": "^1.0",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/queue": "dev-master",
        "yiisoft/rbac": "^2.1",
        "yiisoft/rbac-php": "^2.1",
        "yiisoft/request-body-parser": "^1.2",
        "yiisoft/router": "^4.0",
        "yiisoft/router-fastroute": "^4.0",
        "yiisoft/session": "^3.0",
        "yiisoft/validator": "^2.5",
        "yiisoft/view": "^12.2",
        "yiisoft/yii-console": "^2.4",
        "yiisoft/yii-event": "^2.2",
        "yiisoft/yii-http": "^1.1",
        "yiisoft/yii-runner-console": "^2.2",
        "yiisoft/yii-runner-http": "^3.2",
        "yiisoft/yii-swagger": "^2.2",
        "yiisoft/yii-view-renderer": "^7.4"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.6",
        "friendsofphp/php-cs-fixer": "^3.95.1",
        "infection/infection": "^0.35",
        "rasuvaeff/mutation-history": "^0.1",
        "rasuvaeff/payments-testing": "^0.1.1",
        "rasuvaeff/property-testing-testo": "^1.2",
        "rasuvaeff/rector-named-literals": "^1.0",
        "rasuvaeff/understudy": "^1.1",
        "rasuvaeff/understudy-testo": "^1.0",
        "rector/rector": "^2.6.6",
        "testo/assert": "^0.1.13",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.42",
        "vimeo/psalm": "^6.16.1",
        "yiisoft/test-support": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "yiisoft/config": true,
            "tbachert/spi": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "scripts": {
        "smoke": "bin/smoke.sh",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --diff",
        "psalm": "psalm --no-cache",
        "rector": "rector process --config=rector.php --dry-run",
        "rector:fix": "rector process --config=rector.php",
        "deptrac": [
            "deptrac analyse --config-file=deptrac.yaml --no-progress",
            "deptrac analyse --config-file=deptrac-contexts.yaml --no-progress"
        ],
        "check": [
            "@cs",
            "@psalm",
            "@deptrac",
            "@rector",
            "@php bin/support/class-references.php"
        ]
    }
}
